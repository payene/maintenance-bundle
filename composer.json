{
    "name": "payene/maintenance-bundle",
    "description": "Mode maintenance pour Symfony avec interface d'administration, whitelist et stockage configurable.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "maintenance", "bundle", "503", "maintenance-mode"],
    "homepage": "https://github.com/payene/maintenance-bundle",
    "authors": [
        {
            "name": "Payene"
        }
    ],
    "support": {
        "issues": "https://github.com/payene/maintenance-bundle/issues",
        "source": "https://github.com/payene/maintenance-bundle"
    },
    "require": {
        "php": ">=8.1",
        "symfony/framework-bundle": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/twig-bundle": "^6.4 || ^7.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "symfony/security-csrf": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "suggest": {
        "symfony/cache": "Pour stocker l'état dans Redis, Memcached, Doctrine ou tout autre cache pool Symfony.",
        "symfony/security-csrf": "Requis pour les formulaires d'administration (protection CSRF).",
        "symfony/security-bundle": "Recommandé pour protéger l'interface d'administration."
    },
    "autoload": {
        "psr-4": {
            "Payene\\MaintenanceBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Payene\\MaintenanceBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    }
}