{
    "name": "payene/maintenance-bundle",
    "description": "Maintenance mode for Symfony with a web admin interface, allow list, and configurable storage.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "maintenance", "bundle", "503", "maintenance-mode", "allow-list"],
    "homepage": "https://github.com/payene/maintenance-bundle",
    "authors": [
        {
            "name": "Payene"
        }
    ],
    "support": {
        "issues": "https://github.com/payene/maintenance-bundle/issues",
        "source": "https://github.com/payene/maintenance-bundle"
    },
    "require": {
        "php": ">=8.1",
        "symfony/framework-bundle": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/twig-bundle": "^6.4 || ^7.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "symfony/security-csrf": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "suggest": {
        "symfony/cache": "To store the state in Redis, Memcached, Doctrine, or any other Symfony cache pool.",
        "symfony/security-csrf": "Required for the administration forms (CSRF protection).",
        "symfony/security-bundle": "Recommended to protect the administration interface."
    },
    "autoload": {
        "psr-4": {
            "Payene\\MaintenanceBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Payene\\MaintenanceBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.1-dev"
        }
    }
}